# Supabase project settings (Project Settings > API). These are public by design;
# Row Level Security in Postgres is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Base URL used in auth email links. Leave empty locally; set it in production.
NEXT_PUBLIC_SITE_URL=

# Comma-separated OAuth buttons to show on the sign-in page: google, apple.
# Each must also be enabled in Supabase (Auth > Providers). Empty = magic link only.
NEXT_PUBLIC_AUTH_PROVIDERS=

# Server-only. Geocoder for typed home cities (OpenStreetMap Nominatim, free).
# Leave empty to use the public server; point it at a self-hosted instance at scale.
NOMINATIM_URL=

# Server-only. Service-role "secret" key (Project Settings > API). Needed for account
# deletion and for signing out suspended users. Never expose it to the browser.
SUPABASE_SECRET_KEY=

# Server-only. Text moderation provider for posts and messages. Default: heuristics
# (built in, free). See src/lib/moderation/index.ts to add another.
MODERATION_PROVIDER=

# Server-only. Secret the notification sender checks (Authorization: Bearer <secret>).
# Call /api/cron/notifications every minute or few from any scheduler.
CRON_SECRET=

# Server-only. Email for notifications and the weekly digest via Resend (resend.com).
# EMAIL_FROM must be on a domain verified in Resend, e.g. "Buddies <hello@yourdomain.com>".
RESEND_API_KEY=
EMAIL_FROM=
# Local development only: send email to the Mailpit inbox `supabase start` runs instead.
MAILPIT_URL=http://127.0.0.1:54324

# Web push (VAPID keys). The public key goes to the browser; keep the private key server-only.
# VAPID_SUBJECT is a contact: mailto:you@yourdomain.com or https://yourdomain.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Going global (increment 9) ---------------------------------------------
# Translate button. TRANSLATION_PROVIDER is deepl (default), google or
# libretranslate; the button stays hidden until the matching key/URL is set.
TRANSLATION_PROVIDER=deepl
# DeepL: free-plan keys end in ":fx" (500,000 characters a month free).
DEEPL_API_KEY=
# GOOGLE_TRANSLATE_API_KEY=
# LIBRETRANSLATE_URL=
# LIBRETRANSLATE_API_KEY=
# Exchange rates come from the European Central Bank's free daily file.
# Override only for tests: EXCHANGE_RATES_URL=http://127.0.0.1:54398/eurofxref-daily.xml
# EXCHANGE_RATES_URL=
