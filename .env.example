# Supabase project settings (Project Settings > API). These are public by design;
# Row Level Security in Postgres is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Base URL used in auth email links. Leave empty locally; set it in production.
NEXT_PUBLIC_SITE_URL=
